    {
      "lessonId": "etcl-09-past-experiences",
      "manifestSha256": "286e958323a316bcb127fd7416b435be7b5647c20c08686b823bc6722dfe4d20",
      "entries": [
        {
          "phraseIndex": 0,
          "en": "I got into programming because I wanted to build my own apps and services.",
          "ja": "自分のアプリやサービスを作りたかったので、プログラミングを始めました。",
