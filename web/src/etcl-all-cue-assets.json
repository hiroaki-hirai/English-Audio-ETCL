        },
        {
          "phraseIndex": 2,
          "en": "I haven't decided yet.",
          "ja": "まだ決めていません。",
          "path": "lessons/etcl-11-plans-and-possibilities/japanese-cues-v2/phrase-003.mp3",
          "size": 33792,
          "sha256": "299deb092fc6ebc7e096ae5876527526b416c10f887f320e29a51e5059a227c0"
        },
        {
          "phraseIndex": 3,
          "en": "I'm hoping to make some progress on a few things I've been putting off.",
          "ja": "先延ばしにしていたいくつかのことを、少しでも進められたらと思っています。",
          "path": "lessons/etcl-11-plans-and-possibilities/japanese-cues-v2/phrase-004.mp3",
          "size": 78720,
          "sha256": "224582e7856e6c2285a9e540124d50dad3b10d9974d176cc9fbd20d9ad7aba9b"
        },
        {
          "phraseIndex": 4,
          "en": "I'll see how things go before making any decisions.",
          "ja": "何か決める前に、しばらく様子を見ます。",
          "path": "lessons/etcl-11-plans-and-possibilities/japanese-cues-v2/phrase-005.mp3",
          "size": 57600,
          "sha256": "1d75ef00cb4a38bfe473ea2d1275569ec238adcce7a752a90630544c723c655c"
        },
        {
          "phraseIndex": 5,
          "en": "It depends on how things work out.",
