        },
        {
          "phraseIndex": 1,
          "en": "I'm thinking about trying something new.",
          "ja": "何か新しいことを試してみようかと考えています。",
          "path": "lessons/etcl-11-plans-and-possibilities/japanese-cues-v2/phrase-002.mp3",
          "size": 67968,
