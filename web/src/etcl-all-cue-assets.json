          "size": 31488,
          "sha256": "687696256b8d561d509f95a95ff8d49a93050d55929873e210808f63ac60a6aa"
        },
        {
          "phraseIndex": 1,
          "en": "That makes sense.",
          "ja": "それなら納得です。",
          "path": "lessons/etcl-08-responding-naturally/japanese-cues-v2/phrase-002.mp3",
