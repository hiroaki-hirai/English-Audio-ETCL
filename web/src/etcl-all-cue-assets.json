      "entries": [
        {
          "phraseIndex": 0,
          "en": "I'm planning to spend more time working on my own projects.",
          "ja": "自分のプロジェクトに取り組む時間をもっと増やす予定です。",
          "path": "lessons/etcl-11-plans-and-possibilities/japanese-cues-v2/phrase-001.mp3",
